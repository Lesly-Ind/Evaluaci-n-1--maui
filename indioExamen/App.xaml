<?xml version="1.0" encoding="utf-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:indioExamen"
    x:Class="indioExamen.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- RECURSOS ORIGINALES DE MAUI -->
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="Resources/Styles/Colors.xaml" />

                <ResourceDictionary
                    Source="Resources/Styles/Styles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- ESTILO GLOBAL PARA TITULOS -->
            <Style
                x:Key="TituloGlobal"
                TargetType="Label">

                <Setter
                    Property="FontSize"
                    Value="24"/>

                <Setter
                    Property="FontAttributes"
                    Value="Bold"/>

                <Setter
                    Property="TextColor"
                    Value="#382184"/>

                <Setter
                    Property="HorizontalTextAlignment"
                    Value="Center"/>

            </Style>

            <!-- ESTILO GLOBAL PARA BOTONES -->
            <Style
                x:Key="BotonGlobal"
                TargetType="Button">

                <Setter
                    Property="BackgroundColor"
                    Value="#5634C5"/>

                <Setter
                    Property="TextColor"
                    Value="White"/>

                <Setter
                    Property="FontAttributes"
                    Value="Bold"/>

                <Setter
                    Property="CornerRadius"
                    Value="10"/>

                <Setter
                    Property="HeightRequest"
                    Value="50"/>

            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
